# Copiar como .env (en esta misma carpeta, junto a manage.py) y completar.
# El archivo .env no se sube al repositorio. Las variables definidas en el
# entorno del sistema tienen prioridad sobre las de este archivo.

# --- Django
# Generar una con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Si contiene caracteres especiales, dejarla entre comillas simples.
SECRET_KEY=

# --- Base de datos (MySQL Router, puerto R/W)
DB_NAME=sicma
DB_USER=sicma_app
DB_PASSWORD=
DB_HOST=192.168.100.95
DB_PORT=6446

# --- Correo (recuperación de contraseña y alertas)
# En este equipo EMAIL_HOST_USER y EMAIL_HOST_PASSWORD están definidas como variables
# de entorno de Windows, que tienen prioridad sobre este archivo. Para otro equipo,
# descomentar y completar (la clave es una contraseña de aplicación de Gmail).
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Zabbix
# Endpoint JSON-RPC del servidor Zabbix.
ZABBIX_URL=http://192.168.100.121/zabbix/api_jsonrpc.php
# API token del usuario sicma_api (Zabbix > Users > API tokens).
ZABBIX_TOKEN=
# Secreto compartido que Zabbix envía en la cabecera X-Zabbix-Token del webhook.
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZABBIX_WEBHOOK_SECRET=

# --- Intervenciones (flujo de Power Automate, por correo)
# Correo institucional que usa el flujo: SICMA solo acepta correos de esta cuenta y le envía
# los pedidos de agendar (asunto "[SICMA-INT] AGENDAR #id").
INTERVENCIONES_CORREO_FLUJO=
# Secreto que el flujo pone en el campo "token" del JSON de cada correo (generarlo como el anterior).
INTERVENCIONES_TOKEN=
